# AWS App Runner Environment Variables
# Copy these to your App Runner service configuration

# Application Settings
NODE_ENV=production
PORT=3000

# Database Configuration (Update when migrating to RDS)
# RDS_HOSTNAME=your-rds-endpoint.region.rds.amazonaws.com
# RDS_DB_NAME=yeahbook
# RDS_USERNAME=your-username
# RDS_PASSWORD=your-password
# RDS_PORT=5432

# Auth0 Configuration (Add your Auth0 settings)
# AUTH0_DOMAIN=your-domain.auth0.com
# AUTH0_CLIENT_ID=your-client-id
# AUTH0_CLIENT_SECRET=your-client-secret

# AWS S3 Configuration (For file uploads when migrated)
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Application URL (Will be provided by App Runner)
# APP_URL=https://your-app-id.region.awsapprunner.com