# Elastic Beanstalk ignore file
# Files and directories to exclude from deployment bundle

# Development files
.env
.env.local
.env.development
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
__tests__/
*.test.js
*.spec.js

# Development dependencies (will be installed on server)
node_modules/

# Git
.git/
.gitignore

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Build artifacts (will be built on server)
client/dist/
build/

# Documentation
README.md
docs/

# Development scripts
*.md
!AWS_DEPLOYMENT_GUIDE.md