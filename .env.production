# Production Environment Variables for AWS Deployment
NODE_ENV=production
PORT=8081

# Database Configuration (PostgreSQL on AWS RDS)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_NAME=yeahbook_prod

# Auth0 Configuration
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_AUDIENCE=your-auth0-api-identifier

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
SECRET_API_KEY=your-secret-api-key-here

# AWS S3 Configuration (for file uploads)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-yeahbook-uploads-bucket
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Application URLs
FRONTEND_URL=https://your-app-name.region.elasticbeanstalk.com
API_BASE_URL=https://your-app-name.region.elasticbeanstalk.com/api/v1